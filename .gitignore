# DubFlow gitignore
#
# Commit these:
# - README.md, PIPELINE.md, LICENSE, Start DubFlow App.bat, Install Dependencies.bat
# - Backend/ and Frontend/ source code, tests, config files
# - package.json, package-lock.json, Backend/requirements.txt
# - Backend/.env.example and real documentation images under images/
#
# Do not commit installed libraries, local runtimes, secrets, logs, caches, or
# generated audio/video/job output. Extra bundled libraries should stay outside
# git and be recreated from package-lock.json, requirements.txt, and
# tools/bootstrap.ps1.

# Local assistant/editor state
.agents/
.antigravitycli/
.claude/
.codex/
.git1/

# Local clones/backups
Clone/
-/

# Secrets and local environment
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
Backend/client_secret*.json
Backend/token_cache.json
Backend/*credentials*.json
Backend/*service-account*.json
google-credentials*.json
service-account*.json

# Logs and process output
logs/
**/logs/
*.log
*.err
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.seed
*.pid.lock

# Temporary scratch files
d.txt
tmp/
temp/
*.tmp
*.temp

# Node dependencies and package-manager caches
node_modules/
jspm_packages/
bower_components/
web_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.yarn-integrity

# Frontend/Next/Electron generated files
.next/
out/
dist/
build/
lib-cov/
coverage/
*.lcov
.nyc_output/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
Frontend/.dubflow/
Frontend/.chrome-subedit-*/
Frontend/test-results/
Frontend/playwright-report/
Frontend/blob-report/
Frontend/sub-editor-check.png
playwright-report/
test-results/
blob-report/
*.trace.zip

# Backend job state and generated artifacts
Backend/jobs/*
!Backend/jobs/.gitkeep
Backend/downloads/*
!Backend/downloads/.gitkeep
Backend/data/*
!Backend/data/.gitkeep
Backend/.zipvoice_voice_cache/
Backend/temp/
Backend/tmp*/
Backend/test_outputs/
Backend/tmp_test_job.json

