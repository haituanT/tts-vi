PORT=3001
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_STT_V2_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=
LOCAL_FILE_PICKER_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
GEMINI_CONTEXT_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_KEYS=
ASSEMBLYAI_STT_MODEL=universal-3-5-pro
ASSEMBLYAI_STT_PROCESSING_MODE=parallel
ASSEMBLYAI_STT_CHUNK_SECONDS=180
ASSEMBLYAI_STT_OVERLAP_SECONDS=6
ASSEMBLYAI_STT_CONCURRENCY=3

# Optional AIMAX voice clone / TTS provider.
AIMAX_API_KEY=
AIMAX_BASE_URL=https://aimaxstudio.com
AIMAX_TTS_PROVIDER=minimax
AIMAX_TTS_MODEL=speech-2.8-hd

# Optional local cache root for Faster Whisper / HuggingFace / wtpsplit models.
# Defaults to D:\DubFlowModelCache when unset.
DUBFLOW_MODEL_CACHE_ROOT=
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE_TYPE=int8
